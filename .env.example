# Database connection string
DATABASE_URL=mongodb://127.0.0.1/eagle-ford

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links, canonicals and OG. No trailing slash.
# Local:      http://localhost:3001
# Production: https://www.eagleford.co.za
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# Secret used to authenticate cron jobs (Payload /api/payload-jobs/run for lead retries)
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Eagle Motor City stock API + site-form lead ingest (server-side only — never expose key to client)
# Same API key authenticates both stock reads and POST /api/leads/site-forms
# Local:      http://localhost:3000
# Production: https://www.eaglemotorcity.co.za
MOTOR_CITY_STOCK_API_URL=http://localhost:3000
MOTOR_CITY_STOCK_API_KEY=your-generated-api-key

# Set true only on the live production host that should appear in Google Search.
# Leave unset (or false) for local development.
# ALLOW_SEARCH_INDEXING=true

# SMTP — transactional email via Nodemailer (form mail + Settings → Email test).
# Port 587 uses STARTTLS (secure upgrade after connection).
# Port 465 uses implicit SSL (set SMTP_PORT=465).
# Leave blank to disable email in local development.
# Credentials stay in env — never stored in the CMS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Production example (Mimecast STARTTLS):
# SMTP_HOST=za-smtp-outbound-1.mimecast.co.za
# SMTP_PORT=587
# SMTP_USER=noreply@eaglemc.co.za
# SMTP_PASS=your-password

# SENTRY_DSN is required at runtime for useful Server Component / API errors.
# NEXT_PUBLIC_SENTRY_DSN alone only reports the client; RSC errors are redacted there.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# SENTRY_AUTH_TOKEN=  # Required in Docker/CI build secret for readable production stack traces

# Stabilizes Payload admin Server Action IDs across deploys and container restarts.
# Generate with: openssl rand -base64 32
# Must be present at BUILD time (Docker build secret), not only runtime.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
