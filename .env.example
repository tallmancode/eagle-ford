# Database connection string for local development
DATABASE_URL=mongodb://127.0.0.1/your-database-name

# Docker deployment uses separate build-time and runtime database addresses:
# DATABASE_URL=mongodb://mongo:27017/eagle-ford
# BUILD_DATABASE_URL=mongodb://127.0.0.1:4422/eagle-ford
# APP_HOST_PORT=4411
# MONGO_HOST_PORT=4422

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links, canonicals and OG. No trailing slash.
# Local: http://localhost:3001
# Deployed eagle-ford-dev (Docker/aaPanel): https://eagle-ford-dev.tallmancode.co.za
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Eagle Motor City stock API + site-form lead ingest (server-side only — never expose key to client)
# Same API key authenticates both stock reads and POST /api/leads/site-forms
MOTOR_CITY_STOCK_API_URL=http://localhost:3000
MOTOR_CITY_STOCK_API_KEY=your-generated-api-key

# SENTRY_DSN is required at runtime for useful Server Component / API errors.
# NEXT_PUBLIC_SENTRY_DSN alone only reports the client; RSC messages are redacted there.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=  # Required in Docker/CI build secret for readable production stack traces

# Stabilizes Payload admin Server Action IDs across deploys and container restarts.
# Generate with: openssl rand -base64 32
# Must be present at BUILD time (Docker build secret), not only runtime.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
